---
// Cookie Consent Banner.
//
// What this banner does and does not control, stated plainly because the two
// are different and the old comment above was no longer true:
//
//   Google Ads and GA4  - genuinely gated. Layout.astro sets Consent Mode
//                         defaults to denied and this banner flips them to
//                         granted only on Accept All.
//   Microsoft Clarity   - NOT gated by this banner. The Clarity tag loads on
//                         every page regardless of the choice made here.
//                         Clarity applies its own consent handling instead,
//                         and for visitors from the EEA, UK and Switzerland
//                         Microsoft turns Consent Mode on by default and the
//                         site owner cannot switch it off.
//
// The banner copy therefore does not promise that Necessary Only stops all
// analytics, because it does not.
---

<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-50 hidden">
  <div class="bg-gray-900 text-white px-4 sm:px-6 py-4 shadow-lg border-t border-gray-700">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex-1 text-sm text-gray-300 leading-relaxed">
        We use cookies to improve your experience and analyse site traffic. <strong class="text-white font-semibold">Accept All</strong> allows our advertising and Google Analytics cookies. <strong class="text-white font-semibold">Necessary Only</strong> declines those, but does not switch off Microsoft Clarity, which we use for website interaction analytics and session recordings and which operates subject to Microsoft's own consent controls and applicable law.
        <a href="/cookie-policy/" class="underline text-white hover:text-gray-200 ml-1">Cookie Policy</a>
        <a href="/privacy-policy/" class="underline text-white hover:text-gray-200 ml-1">Privacy Policy</a>
      </div>
      <div class="flex gap-3 shrink-0">
        <button id="cookie-reject" class="px-4 py-2 text-sm font-medium border border-gray-500 rounded-lg hover:bg-gray-800 transition-colors">
          Necessary Only
        </button>
        <button id="cookie-accept" class="px-4 py-2 text-sm font-medium bg-brand text-white rounded-lg hover:bg-brand-dark transition-colors">
          Accept All
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const rejectBtn = document.getElementById('cookie-reject');

    // Show banner only if no choice has been made yet.
    // The Google tag loads in Layout.astro with Consent Mode defaults and this
    // banner only updates that state. Clarity is deliberately not touched
    // here: it loads unconditionally and manages consent itself.
    if (!localStorage.getItem('cookie-consent')) {
      banner?.classList.remove('hidden');
    }

    acceptBtn?.addEventListener('click', () => {
      localStorage.setItem('cookie-consent', 'all');
      if (typeof gtag === 'function') {
        gtag('consent', 'update', {
          'ad_personalization': 'granted',
          'analytics_storage': 'granted'
        });
      }
      banner?.classList.add('hidden');
    });

    rejectBtn?.addEventListener('click', () => {
      localStorage.setItem('cookie-consent', 'necessary');
      // No gtag consent update needed: Layout.astro already defaults
      // analytics_storage and ad_personalization to denied. And no Clarity
      // call is made, by design, because Clarity is not gated by this banner.
      banner?.classList.add('hidden');
    });
  });
</script>
