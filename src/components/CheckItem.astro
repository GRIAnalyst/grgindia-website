---
// Feature-list bullet with brand checkmark icon.
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<li class="flex items-start gap-2.5">
  <span class="mt-0.5 flex-shrink-0 w-4 h-4 rounded-full bg-brand/10 flex items-center justify-center"
    ><svg class="w-2.5 h-2.5 text-brand" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"
      ><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg
    ></span>
  <span class="text-sm text-gray-700">{text}</span>
</li>
