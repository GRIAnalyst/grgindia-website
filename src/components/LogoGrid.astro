---
// Client logo strip — shared across homepage and product pages.
// Each logo: src/alt plus intrinsic width/height (prevents layout shift).
// `tall` renders at h-16 instead of h-12; `blend` applies mix-blend-multiply
// for logos with non-white backgrounds.
interface Logo {
  src: string;
  alt: string;
  width: number;
  height: number;
  tall?: boolean;
  blend?: boolean;
}

interface Props {
  logos: Logo[];
  heading?: string;
  /** Tailwind grid-cols classes; default matches the homepage strip */
  cols?: string;
}

const {
  logos,
  heading = 'Trusted by',
  cols = 'grid-cols-3 sm:grid-cols-4 md:grid-cols-6',
} = Astro.props;
---

<section class="py-10 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="anim-fade-up text-3xl md:text-4xl font-bold text-center text-navy mb-8">{heading}</h2>
    <div class={`grid ${cols} gap-8 md:gap-10 items-center justify-items-center`}>
      {logos.map((logo, i) => (
        <img
          loading="lazy"
          decoding="async"
          src={logo.src}
          alt={logo.alt}
          width={logo.width}
          height={logo.height}
          class={`anim-scale-in ${logo.tall ? 'h-16' : 'h-12'} w-full object-contain grayscale hover:grayscale-0 transition-[filter] duration-300`}
          data-anim-delay={String(i * 50)}
          style={logo.blend ? 'mix-blend-mode:multiply' : undefined}
        />
      ))}
    </div>
  </div>
</section>
