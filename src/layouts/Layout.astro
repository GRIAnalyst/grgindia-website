---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { FOUNDING_YEAR } from '../lib/company';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown>;
  /**
   * Optional LCP image preload. A page that knows which image will be its
   * Largest Contentful Paint can declare it here, and the link lands in <head>
   * ahead of the stylesheet, so the preload scanner starts the download before
   * CSS has blocked rendering. Omit it and nothing is emitted.
   *
   * srcset and sizes must match the <picture> on the page exactly, or the
   * browser preloads one file and then downloads a different one.
   *
   * Pass `media` when the image is only the LCP element at some widths. A
   * hero that stacks below the copy on mobile is usually at or below the
   * fold there, so preloading it at high priority on a phone takes early
   * bandwidth from whatever actually paints first.
   */
  preloadImage?: { srcset: string; sizes: string; type?: string; media?: string };
}

const {
  title,
  description = 'GRG India - Channel Incentive & Loyalty Solutions',
  ogTitle,
  ogDescription,
  ogImage = 'https://www.grgindia.in/images/home-banner.png',
  canonical,
  jsonLd,
  preloadImage,
} = Astro.props;

const resolvedOgTitle = ogTitle || title;
const resolvedOgDesc = ogDescription || description;
const canonicalUrl = canonical || new URL(Astro.url.pathname, 'https://www.grgindia.in').href;

// ---------------------------------------------------------------------------
// Structured data
//
// Previously this file read `jsonLd || orgSchema`, so any page that passed its
// own schema LOST the Organization node altogether. That was 81 of 99 pages,
// including every blog post, /solar/ and /channel-loyalty-program/ — the pages
// that most need to tell Google who publishes them. The page-specific schemas
// carried only thin inline stubs (name and url, no logo, address or profiles).
//
// Now the Organization is always emitted, and the page's own schema is merged
// alongside it in a single @graph. The Organization carries a stable @id, and
// the GRG stubs inside page schemas are replaced by references to that @id, so
// the document describes one company rather than several near-duplicates.
// ---------------------------------------------------------------------------

const ORGANIZATION_ID = 'https://www.grgindia.in/#organization';

const orgSchema = {
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: 'GRG India',
  legalName: 'TajOnline Pvt. Ltd.',
  url: 'https://www.grgindia.in',
  // An ImageObject rather than a bare URL string. Blog posts used to supply
  // their own publisher.logo in this shape; now that they reference the
  // Organization by @id instead, the logo has to be just as complete here.
  logo: {
    '@type': 'ImageObject',
    url: 'https://www.grgindia.in/images/grg-india-logo.png',
  },
  // 2008, read from FOUNDING_YEAR in src/lib/company.ts, which is also what
  // the "N years" lines on the home, contact and channel loyalty pages count
  // from. Same value either way, kept in one place so it cannot drift.
  foundingDate: String(FOUNDING_YEAR),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Satya House, 402, Hi-Tech IT Park 2nd & 4th Floor',
    addressLocality: 'Sewri West',
    addressRegion: 'Mumbai',
    postalCode: '400015',
    addressCountry: 'IN',
  },
  // The same profiles the footer already links on every page.
  sameAs: [
    'https://www.linkedin.com/company/grg-india/',
    'https://www.youtube.com/@tajonlinetajgifts4235',
    'https://x.com/GRG_India',
    'https://www.facebook.com/GRGIndiaTeam/',
  ],
};

// Properties whose value is the publishing company rather than a third party.
// Only these are rewritten, and only when the value is recognisably GRG India,
// so a future schema naming an outside author or hiring partner is left alone.
const ORG_REFERENCE_KEYS = ['provider', 'author', 'publisher', 'hiringOrganization'];

function isGrgOrganization(value: unknown): boolean {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
  const node = value as Record<string, unknown>;
  if (node['@type'] !== 'Organization') return false;
  const url = typeof node.url === 'string' ? node.url : '';
  const sameAs = typeof node.sameAs === 'string' ? node.sameAs : '';
  return node.name === 'GRG India' || url.includes('grgindia.in') || sameAs.includes('grgindia.in');
}

/** Drop the node's own @context and point its GRG stubs at the shared @id. */
function linkToOrganization(node: Record<string, unknown>): Record<string, unknown> {
  const { '@context': _context, ...rest } = node;
  for (const key of ORG_REFERENCE_KEYS) {
    if (key in rest && isGrgOrganization(rest[key])) {
      rest[key] = { '@id': ORGANIZATION_ID };
    }
  }
  return rest;
}

// A page may pass a single node or an object wrapping its own @graph. Both are
// flattened to a list so everything ends up in one graph with one @context.
const rawPageNodes = !jsonLd
  ? []
  : Array.isArray((jsonLd as Record<string, unknown>)['@graph'])
    ? ((jsonLd as Record<string, unknown>)['@graph'] as Record<string, unknown>[])
    : [jsonLd as Record<string, unknown>];

const pageNodes = rawPageNodes.map(linkToOrganization);

const schemaToRender = {
  '@context': 'https://schema.org',
  '@graph': [orgSchema, ...pageNodes],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />

    {
      /* LCP image preload, when the page declares one. Placed above the
         stylesheet so the preload scanner starts the image before CSS blocks
         rendering. */
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type}
          media={preloadImage.media}
          fetchpriority="high"
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="GRG India" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDesc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaToRender)} />

    <!-- Google tag (gtag.js) with Consent Mode: Google Ads conversion tracking + GA4 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('consent', 'default', {
        'ad_storage': 'granted',
        'ad_user_data': 'granted',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied'
      });

      if (localStorage.getItem('cookie-consent') === 'all') {
        gtag('consent', 'update', {
          'ad_personalization': 'granted',
          'analytics_storage': 'granted'
        });
      }

      gtag('js', new Date());
      gtag('config', 'AW-11342761792');          // Google Ads conversion tracking
      gtag('config', 'G-D7VZH7Y0MW');          // GA4 site analytics
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-11342761792"></script>

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <!-- Animation Styles & Intersection Observer -->
    <style>
      /* ---- Brand button (replaces inline onmouseover/onmouseout) ---- */
      .btn-brand-red {
        background-color: var(--brand-red);
        color: #ffffff;
      }
      .btn-brand-red:hover {
        background-color: var(--brand-red-dark);
      }

      /* ---- Base hidden states ---- */
      .anim-fade-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease-out, transform 0.7s ease-out;
      }
      .anim-fade-up.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      .anim-fade-in {
        opacity: 0;
        transition: opacity 0.7s ease-out;
      }
      .anim-fade-in.is-visible {
        opacity: 1;
      }

      .anim-slide-left {
        opacity: 0;
        transform: translateX(-40px);
        transition: opacity 0.7s ease-out, transform 0.7s ease-out;
      }
      .anim-slide-left.is-visible {
        opacity: 1;
        transform: translateX(0);
      }

      .anim-slide-right {
        opacity: 0;
        transform: translateX(40px);
        transition: opacity 0.7s ease-out, transform 0.7s ease-out;
      }
      .anim-slide-right.is-visible {
        opacity: 1;
        transform: translateX(0);
      }

      .anim-scale-in {
        opacity: 0;
        transform: scale(0.9);
        transition: opacity 0.5s ease-out, transform 0.5s ease-out;
      }
      .anim-scale-in.is-visible {
        opacity: 1;
        transform: scale(1);
      }

      /* Respect prefers-reduced-motion */
      @media (prefers-reduced-motion: reduce) {
        .anim-fade-up,
        .anim-fade-in,
        .anim-slide-left,
        .anim-slide-right,
        .anim-scale-in {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      }
    </style>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // ---- Intersection Observer for scroll animations ----
        const animEls = document.querySelectorAll(
          '.anim-fade-up, .anim-fade-in, .anim-slide-left, .anim-slide-right, .anim-scale-in'
        );

        if (animEls.length === 0) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target;
                const delay = el.dataset.animDelay || '0';
                setTimeout(() => {
                  el.classList.add('is-visible');
                }, parseInt(delay));
                observer.unobserve(el);
              }
            });
          },
          { threshold: 0.15 }
        );

        animEls.forEach((el) => observer.observe(el));

        // ---- Counter animation for stats ----
        const counters = document.querySelectorAll('[data-count-to]');
        if (counters.length === 0) return;

        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target;
                const target = el.dataset.countTo;
                const suffix = el.dataset.countSuffix || '';
                const prefix = el.dataset.countPrefix || '';
                const isDecimal = target.includes('.');
                const numTarget = parseFloat(target);
                const duration = 1500;
                const startTime = performance.now();

                function update(currentTime) {
                  const elapsed = currentTime - startTime;
                  const progress = Math.min(elapsed / duration, 1);
                  // Ease-out cubic
                  const eased = 1 - Math.pow(1 - progress, 3);
                  const current = eased * numTarget;

                  if (isDecimal) {
                    el.textContent = prefix + current.toFixed(1) + suffix;
                  } else {
                    el.textContent = prefix + Math.floor(current).toLocaleString() + suffix;
                  }

                  if (progress < 1) {
                    requestAnimationFrame(update);
                  } else {
                    // Ensure final value is exact
                    el.textContent = prefix + target + suffix;
                  }
                }

                requestAnimationFrame(update);
                counterObserver.unobserve(el);
              }
            });
          },
          { threshold: 0.5 }
        );

        counters.forEach((el) => counterObserver.observe(el));
      });
    </script>
  </body>
</html>
