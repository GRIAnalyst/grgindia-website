  <!-- FAQs. Collapsed accordion: semantic buttons with aria-expanded and
       aria-controls, the panel height animated with grid-template-rows so it
       can go from nothing to its natural height without a hard-coded
       max-height. Every answer is in the DOM on load, so the FAQPage schema
       and the visible text match exactly. -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold tracking-[0.14em] uppercase text-brand anim-fade-up">FAQs</p>
      <h2 class="mt-4 text-3xl md:text-4xl font-bold text-navy anim-fade-up" data-anim-delay="50">
        Frequently asked questions
      </h2>
      <p class="mt-4 text-lg text-gray-600 max-w-3xl anim-fade-up" data-anim-delay="100">
        What an electrician loyalty program is, how a job is recorded and how electricians are paid.
      </p>

      <div id="electrician-faq" class="mt-12 border-t border-gray-200 anim-fade-up" data-anim-delay="150">
        {
          faqs.map((f, i) => (
            <div class="border-b border-gray-200">
              <h3 class="m-0">
                <button
                  type="button"
                  id={`faq-trigger-${i}`}
                  aria-controls={`faq-panel-${i}`}
                  aria-expanded="false"
                  class="faq-trigger w-full flex items-start justify-between gap-6 py-5 text-left cursor-pointer group"
                >
                  <span class="text-base md:text-lg font-bold text-navy leading-snug group-hover:text-brand transition-colors">
                    {f.q}
                  </span>
                  <svg
                    class="faq-icon mt-1 w-5 h-5 shrink-0 text-brand transition-transform duration-200"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </h3>
              <div
                id={`faq-panel-${i}`}
                role="region"
                aria-labelledby={`faq-trigger-${i}`}
                class="faq-panel"
                data-open="false"
              >
                <div class="faq-panel-inner">
                  <div class="pb-5">
                    <p class="pr-10 text-[15px] leading-relaxed text-gray-600">{f.a}</p>
                    {f.source && (
                      <p class="mt-2.5 pr-10 text-[13px] leading-relaxed text-gray-500">
                        Source:{' '}
                        <a
                          href={f.source.href}
                          target="_blank"
                          rel="noopener"
                          class="text-brand underline underline-offset-2 hover:no-underline"
                        >
                          {f.source.label}
                        </a>
                      </p>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    /* Accordion panel. grid-template-rows animates from 0fr to 1fr, which goes
       from nothing to the panel's natural height without hard-coding a
       max-height. visibility keeps collapsed answers out of the a11y tree. */
    .faq-panel {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition: grid-template-rows 0.28s ease, visibility 0.28s;
    }
    .faq-panel[data-open='true'] {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .faq-panel-inner {
      overflow: hidden;
    }
    .faq-trigger[aria-expanded='true'] .faq-icon {
      transform: rotate(180deg);
    }
    @media (prefers-reduced-motion: reduce) {
      .faq-panel,
      .faq-icon {
        transition: none;
      }
    }

    /* Client logo marquee. The track holds two identical copies of the list,
       so translating it by exactly -50% puts copy two where copy one started
       and the loop never shows a seam. */
    .logo-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        black 6rem,
        black calc(100% - 6rem),
        transparent
      );
      mask-image: linear-gradient(
        to right,
        transparent,
        black 6rem,
        black calc(100% - 6rem),
        transparent
      );
    }
    .logo-track {
      display: flex;
      width: max-content;
      animation: logo-marquee 45s linear infinite;
    }
    .logo-marquee:hover .logo-track,
    .logo-marquee:focus-within .logo-track {
      animation-play-state: paused;
    }
    @keyframes logo-marquee {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .logo-track {
        animation: none;
      }
      .logo-marquee {
        overflow-x: auto;
        -webkit-mask-image: none;
        mask-image: none;
      }
    }
  </style>

  <script>
    (() => {
      const root = document.getElementById('electrician-faq');
      if (!root) return;
      const triggers = Array.from(root.querySelectorAll('.faq-trigger'));

      const setOpen = (btn: Element, open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        const id = btn.getAttribute('aria-controls');
        const panel = id ? document.getElementById(id) : null;
        panel?.setAttribute('data-open', String(open));
      };

      triggers.forEach((btn) => {
        btn.addEventListener('click', () => {
          const wasOpen = btn.getAttribute('aria-expanded') === 'true';
          // Only one answer open at a time.
          triggers.forEach((other) => setOpen(other, false));
          if (!wasOpen) setOpen(btn, true);
        });

        btn.addEventListener('keydown', (e) => {
          const ev = e as KeyboardEvent;
          if (ev.key === 'Escape') {
            setOpen(btn, false);
            (btn as HTMLButtonElement).focus();
          }
        });
      });
    })();
  </script>

  <script>
    const form = document.getElementById('electrician-form') as HTMLFormElement | null;
    const btn = document.getElementById('electrician-submit') as HTMLButtonElement | null;
    const status = document.getElementById('electrician-status');
    const LABEL = 'Book a 20-minute walkthrough';

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!btn || !status) return;

      btn.disabled = true;
      btn.textContent = 'Sending…';
      status.classList.add('hidden');

      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const rawPhone = (data.phone || '').replace(/\D/g, '');

      if (rawPhone.length !== 10) {
        status.textContent = 'Please enter a valid 10-digit phone number.';
        status.className = 'text-sm text-center mt-2 text-red-500';
        status.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = LABEL;
        return;
      }

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: data.name,
            email: data['work-email'],
            phone: '+91 ' + rawPhone,
            company: data.company,
            teamSize: data['electrician-count'],
            // What the visitor wrote, when they wrote something. The fallback
            // keeps the old behaviour so an empty box still tells whoever
            // reads the email which form it came from.
            message: (data.message || '').trim() || 'Electrician loyalty program enquiry.',
            website: data.website || '',
            formSource: 'electrician-landing',
          }),
        });

        if (!res.ok) throw new Error('Request failed');

        // Google Ads conversion — fires only on successful lead submit, and
        // before reset() so enhanced conversions can still read the email.
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'conversion', {
            send_to: 'AW-11342761792/sj73CLOxyP4YEMCe06Aq',
          });
        }

        form.reset();
        status.textContent = 'Thank you! We will be in touch within one business day.';
        status.className = 'text-sm text-center mt-2 text-green-600';
        status.classList.remove('hidden');
      } catch {
        status.textContent =
          'Something went wrong. Please try again or email contactus@grgindia.in.';
        status.className = 'text-sm text-center mt-2 text-red-500';
        status.classList.remove('hidden');
      }

      btn.disabled = false;
      btn.textContent = LABEL;
    });
  </script>
